rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data, userId) {
      return data.userId == userId &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        data.preferredMode in ['girlfriend', 'assistant', 'friend', 'mentor', 'waifu'] &&
        (!('preferredLanguage' in data) || (data.preferredLanguage is string && data.preferredLanguage.size() <= 50)) &&
        data.keys().hasAll(['userId', 'displayName', 'preferredMode', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'displayName', 'email', 'preferredMode', 'preferredLanguage', 'createdAt', 'updatedAt']);
    }

    function isValidChatMessage(data, userId, messageId) {
      return data.id == messageId &&
        data.userId == userId &&
        data.role in ['user', 'sophia'] &&
        data.content is string && data.content.size() <= 8000 &&
        (!('spokenText' in data) || (data.spokenText is string && data.spokenText.size() <= 8000)) &&
        data.sentiment in ['happy', 'calm', 'loving', 'thoughtful', 'empathetic', 'energetic'] &&
        (!('voiceEngine' in data) || (data.voiceEngine is string && data.voiceEngine.size() <= 50)) &&
        (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 64)) &&
        data.keys().hasAll(['id', 'userId', 'role', 'content', 'sentiment', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'role', 'content', 'spokenText', 'sentiment', 'voiceEngine', 'timestamp', 'createdAt']);
    }

    function isValidLearnedInsight(data, userId, insightId) {
      return data.id == insightId &&
        data.userId == userId &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
        data.fact is string && data.fact.size() > 0 && data.fact.size() <= 2000 &&
        data.confidence is number && data.confidence >= 0 && data.confidence <= 1 &&
        (!('learnedAt' in data) || (data.learnedAt is string && data.learnedAt.size() <= 64)) &&
        data.keys().hasAll(['id', 'userId', 'category', 'fact', 'confidence', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'category', 'fact', 'confidence', 'learnedAt', 'createdAt']);
    }

    function isValidCreation(data, userId, creationId) {
      return data.id == creationId &&
        data.userId == userId &&
        data.type in ['music', 'image', 'video', 'transcription', 'grounding'] &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.prompt is string && data.prompt.size() <= 4000 &&
        (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 100000)) &&
        data.keys().hasAll(['id', 'userId', 'type', 'title', 'prompt', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'type', 'title', 'prompt', 'mediaUrl', 'createdAt']);
    }

    // User collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) &&
        isValidUser(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId) &&
        isValidUser(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'preferredMode', 'preferredLanguage', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: Chat Messages
      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(messageId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(messageId) &&
          isValidChatMessage(incoming(), userId, messageId) &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(messageId);
      }

      // Subcollection: Fast Learner Memory Insights
      match /insights/{insightId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(insightId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(insightId) &&
          isValidLearnedInsight(incoming(), userId, insightId) &&
          incoming().createdAt == request.time;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(insightId) &&
          isValidLearnedInsight(incoming(), userId, insightId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['category', 'fact', 'confidence', 'learnedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(insightId);
      }

      // Subcollection: Multimodal AI Studio Creations
      match /creations/{creationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(creationId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(creationId) &&
          isValidCreation(incoming(), userId, creationId) &&
          incoming().createdAt == request.time;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(creationId) &&
          isValidCreation(incoming(), userId, creationId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'prompt', 'mediaUrl']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(creationId);
      }
    }
  }
}
